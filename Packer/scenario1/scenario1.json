{
  "variables": {
    "aws_region": "us-east-2"
  },
  "builders": [
    {
      "type": "amazon-ebs",
      "region": "{{user `aws_region`}}",
      "instance_type": "t3.micro",
      "ssh_username": "ubuntu",
      "ami_name": "scenario1-packer-{{timestamp}}",
      "source_ami_filter": {
        "filters": {
          "name": "ubuntu/images/*ubuntu-jammy-22.04-amd64-server-*",
          "virtualization-type": "hvm",
          "root-device-type": "ebs"
        },
        "owners": ["099720109477"],
        "most_recent": true
      }
    }
  ]
}
